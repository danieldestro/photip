{
  "name": "potof-backend",
  "private": true,
  "version": "0.7.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && prisma db seed && node --env-file-if-exists=.env dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force --skip-seed",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@google/genai": "^2.15.0",
    "@prisma/client": "^6.19.2",
    "axios": "^1.7.7",
    "axios-cookiejar-support": "^5.0.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "fastify": "^4.28.1",
    "form-data": "^4.0.0",
    "openai": "^7.3.0",
    "tough-cookie": "^4.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.4",
    "@types/tough-cookie": "^4.0.5",
    "prisma": "^6.19.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
