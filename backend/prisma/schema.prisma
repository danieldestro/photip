generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Configurações da aplicação editáveis via admin e persistidas no banco — ao contrário das
// feature flags de backend/src/config.ts (env vars fixas no deploy). Singleton (id sempre 1):
// não existe caso de uso hoje pra múltiplas linhas de configuração. Se a linha não existir ainda
// (banco novo, sem seed), o código lê como default em vez de falhar — ver providers/syncSettings.ts.
model Configuracao {
  id                  Int      @id @default(1)
  // Janela (em dias) usada pelo sync incremental de eventos dos provedores externos — ver
  // providers/syncRunner.ts e providers/focoRadicalAdapter.ts.
  syncIncrementalDias Int      @default(30) @map("sync_incremental_dias")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("configuracoes")
}

// Provedor de fotos/eventos. "proprio=true" identifica o(s) provedor(es) cujos
// eventos/fotos são armazenados e servidos localmente (BD próprio); os demais
// (ex: Fotop) são fontes externas acessadas via adapter específico (fase futura).
model Provedor {
  id          Int      @id @default(autoincrement())
  // Chave estável usada pelo registry de adapters (backend/src/providers/registry.ts)
  // pra resolver qual implementação usar — "nome" é texto livre editável no admin,
  // não serve pra isso.
  slug        String   @unique
  nome        String   @unique
  descricao   String?  @db.Text
  urlSite     String?  @map("url_site")
  ativo       Boolean  @default(true)
  proprio     Boolean  @default(false)

  // Preenchidos pelo sync (manual ou automático — ver backend/src/providers/scheduler.ts)
  // sempre que ele roda pra este provedor, com sucesso ou falha.
  ultimaSincronizacaoEm        DateTime? @map("ultima_sincronizacao_em")
  ultimaSincronizacaoResultado String?   @map("ultima_sincronizacao_resultado") @db.Text

  // Overrides opcionais dos limites de sincronização deste provedor — null usa o default
  // hardcoded do adapter (ver providers/fotopAdapter.ts, focoRadicalAdapter.ts,
  // fottoAdapter.ts). syncJanelaIncrementalDias, quando null, cai no default GLOBAL
  // (Configuracao.syncIncrementalDias) em vez de um valor fixo no código — os outros dois não
  // têm equivalente global. Nenhum dos três é usado pelo Fotto na janela de dias: o catálogo
  // dele não é filtrado por data (early-stop por página sem novidade), só syncMaxPaginas se
  // aplica lá.
  syncMaxPaginas            Int? @map("sync_max_paginas")
  syncJanelaIncrementalDias Int? @map("sync_janela_incremental_dias")
  syncJanelaCompletaDias    Int? @map("sync_janela_completa_dias")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  eventos              Evento[]
  categoriasProvedores CategoriaProvedor[]
  sincronizacoesLog    SincronizacaoLog[]

  @@map("provedores")
}

enum StatusSincronizacao {
  em_andamento
  sucesso
  erro
}

// Histórico de execuções do sync de eventos (manual via admin ou automático via
// scheduler — ver backend/src/providers/syncRunner.ts). Diferente de
// Provedor.ultimaSincronizacaoEm/Resultado, que só guarda o resultado da última
// execução: aqui cada rodada vira uma linha própria, permitindo consultar o
// histórico completo (quando rodou, quanto durou, com que erro).
model SincronizacaoLog {
  id           Int                 @id @default(autoincrement())
  // Nome do processo que gerou o log — hoje só "sync_eventos" existe, mas o campo
  // é livre para acomodar outros processos agendados no futuro sem migration nova.
  processo     String              @db.VarChar(50)
  provedorId   Int                 @map("provedor_id")
  provedor     Provedor            @relation(fields: [provedorId], references: [id], onDelete: Cascade)
  iniciadoEm   DateTime            @default(now()) @map("iniciado_em")
  finalizadoEm DateTime?           @map("finalizado_em")
  status       StatusSincronizacao @default(em_andamento)
  mensagemErro String?             @db.Text @map("mensagem_erro")

  // Métricas da execução — preenchidas só ao concluir com sucesso (ver syncRunner.ts), null
  // enquanto em_andamento ou se falhar antes de o adapter retornar um resultado.
  paginasLidas         Int? @map("paginas_lidas")
  registrosLidos       Int? @map("registros_lidos")
  registrosAtualizados Int? @map("registros_atualizados")

  @@index([provedorId])
  @@map("sincronizacoes_log")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nome      String
  descricao String?  @db.Text
  // Caminho (relativo ao front, ex: /categoria-icons/treino.svg) do ícone da categoria — nem
  // toda Categoria tem um: as originais do Fotop usam a fonte de ícones fi-estacao (ver
  // frontend/src/styles/fi-estacao.css) e ficam com este campo null; as novas trazidas pelo
  // catálogo do Foco Radical não têm glifo nessa fonte, então usam este ícone próprio (SVGs
  // baixados do catálogo público de filtros do focoradical.com.br) como alternativa.
  icone     String?
  // Posição de exibição no carrossel de categorias (CategoryPills) — menor primeiro, com nome
  // como desempate. Um punhado de categorias populares tem posição fixa (ver PINNED_CATEGORIA_IDS
  // em seed.ts); as demais seguem em ordem alfabética a partir daí. Não afeta o <select> de
  // filtro (FilterSelects), que sempre lista em ordem alfabética independente deste campo.
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  eventos              Evento[]
  categoriasProvedores CategoriaProvedor[]

  @@map("categorias")
}

// Mapeia a categoria própria para o id que cada provedor externo usa pra
// classificar o mesmo tipo de evento (ex: fotop's id_estacoes) — necessário
// pro futuro sync/adapter de eventos saber a que Categoria local um evento
// importado de um provedor pertence.
model CategoriaProvedor {
  id                  Int       @id @default(autoincrement())
  categoriaId         Int       @map("categoria_id")
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  provedorId          Int       @map("provedor_id")
  provedor            Provedor  @relation(fields: [provedorId], references: [id])
  idCategoriaProvedor String    @map("id_categoria_provedor")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Sem unicidade em (categoria_id, provedor_id): uma mesma categoria local pode ter N ids
  // diferentes mapeados pro mesmo provedor (sinônimos do catálogo do provedor — ex: Foco Radical
  // tem "Beach Tennis" com os ids 76/173/40 todos apontando pra mesma Categoria local). O que não
  // pode é um id de categoria de um provedor apontar pra mais de uma categoria local — daí a
  // unicidade ficar só em (provedor_id, id_categoria_provedor).
  @@unique([provedorId, idCategoriaProvedor])
  @@map("categorias_provedores")
}

model Evento {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?  @db.Text
  local       String?
  dataHora    DateTime @map("data_hora")
  cidade      String?
  uf          String?
  pais        String?  @default("BR")

  categoriaId Int       @map("categoria_id")
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  searchSelfie Boolean @default(false) @map("search_selfie")
  searchBib    Boolean @default(false) @map("search_bib")
  searchName   Boolean @default(false) @map("search_name")

  provedorId       Int      @map("provedor_id")
  provedor         Provedor @relation(fields: [provedorId], references: [id])
  idEventoProvedor String?  @map("id_evento_provedor")

  // TEXT em vez de VARCHAR: URL do evento no site do provedor, montada a partir do slug/path
  // que o Foco Radical gera do nome do evento — tamanho tão imprevisível quanto o de urlCapa
  // logo abaixo, e um VARCHAR(200) já estourou num sync completo (ver focoRadicalAdapter.ts).
  urlSite   String?  @db.Text @map("url_site")
  // VARCHAR(191) (o padrão do Prisma) estourou com URLs de capa do Foco Radical baseadas no
  // nome original do arquivo enviado pelo organizador do evento — não tem tamanho previsível.
  urlCapa   String?  @db.VarChar(500) @map("url_capa")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fotos Foto[]

  // Evita duplicar o mesmo evento de um provedor externo se ele for
  // resincronizado; não se aplica a eventos próprios (idEventoProvedor nulo).
  @@unique([provedorId, idEventoProvedor])
  // Modelado aqui (em vez de só existir "à mão" na migration.sql) pra `prisma migrate dev` parar
  // de propor DROP INDEX nesse índice toda vez que rodar — ele não fazia parte do datamodel antes,
  // então todo diff futuro achava que era drift e tentava removê-lo (já aconteceu 2x nesta sessão).
  @@fulltext([nome, local, cidade, uf, descricao], map: "eventos_busca_fulltext")
  @@map("eventos")
}

enum Perfil {
  admin
  user
}

// Tabela única para clientes/participantes e para quem acessa o backoffice
// (perfil=admin) — sem tabela separada de admin. senhaHash só é setado pra
// quem efetivamente faz login (hoje só perfil=admin; login de cliente é
// trabalho futuro). Nunca é devolvido pela API — ver o `omit` global em
// backend/src/db/prisma.ts.
model Usuario {
  id             Int       @id @default(autoincrement())
  nome           String
  email          String    @unique
  cpf            String?   @unique
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  cidade         String?
  uf             String?
  pais           String?   @default("BR")
  perfil         Perfil    @default(user)
  senhaHash      String?   @map("senha_hash")
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  fotografo Fotografo?

  @@map("usuarios")
}

model Fotografo {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fotos Foto[]

  @@map("fotografos")
}

model Foto {
  id          Int       @id @default(autoincrement())
  eventoId    Int       @map("evento_id")
  evento      Evento    @relation(fields: [eventoId], references: [id])
  fotografoId Int       @map("fotografo_id")
  fotografo   Fotografo @relation(fields: [fotografoId], references: [id])
  urlFoto     String    @map("url_foto")
  urlThumb    String?   @map("url_thumb")
  takenAt     DateTime? @map("taken_at")
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("fotos")
}
