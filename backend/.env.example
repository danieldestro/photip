# Copie este arquivo para .env e preencha os valores localmente.
# Em produção (Railway), configure essas mesmas variáveis no painel do projeto —
# o .env não é usado lá, apenas em desenvolvimento local (ver backend/package.json).

# Connection string do MySQL próprio (ver docker-compose.yml na raiz do repo
# para subir uma instância local).
DATABASE_URL="mysql://potof:potof@localhost:3306/potof"

# Segredo usado para assinar o cookie de sessão do admin. Gere um valor aleatório
# de pelo menos 32 caracteres em produção (ex: `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=dev-only-secret-change-me-please-1234567890

# Usadas só pelo script de seed (`npm run prisma:seed`) para criar o primeiro
# usuário admin, caso ainda não exista nenhum.
ADMIN_SEED_EMAIL=admin@potof.com.br
ADMIN_SEED_PASSWORD=changeme123

# Sincronização automática de catálogo dos provedores externos (ver
# backend/src/providers/scheduler.ts) — roda sozinha em background, sem cron
# externo. SYNC_SCHEDULER_ENABLED=false desliga completamente.
SYNC_SCHEDULER_ENABLED=true
SYNC_INTERVAL_HOURS=6

# Liga/desliga o botão de efeitos com IA no visualizador de fotos.
FEATURE_AI_PHOTO_EDIT=false

# Provedor usado para gerar os efeitos: "openai" ou "gemini".
AI_PROVIDER=openai

# Necessário apenas se AI_PROVIDER=openai.
OPENAI_API_KEY=

# Necessário apenas se AI_PROVIDER=gemini.
GEMINI_API_KEY=
